# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/todo_db

# Authentication Secrets
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
BETTER_AUTH_SECRET=your-better-auth-secret-here
SESSION_SECRET=your-session-secret-here

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# MCP Server Secret
MCP_SERVER_SECRET=your-mcp-server-secret-here

# Server Configuration
NEXT_PUBLIC_API_URL=${SPACE_URL:-https://localhost:8000}
NEXT_PUBLIC_BACKEND_URL=${SPACE_URL:-https://localhost:8000}

# For local development with SQLite database
DEV_DATABASE_URL=sqlite:///./todo_app_dev.db