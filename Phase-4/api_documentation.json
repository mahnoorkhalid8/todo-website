                        "type": "object",
                        "properties": {
                          "loc": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {"type": "string"},
                                {"type": "integer"}
                              ]
                            }
                          },
                          "msg": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          }
